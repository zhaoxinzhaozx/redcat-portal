PORT=8081
BASE_PATH=/portal
DB_SCHEMA=portal
CLAIM_KEY_PREFIX=portal-claim

# 页面上显示的名称、口号、客服和接口地址。
SITE_NAME=我的站点
SITE_SLOGAN=一处接入，一路送达
SUPPORT_CONTACT=客服联系方式
SITE_URL=https://example.com

# 下载按钮。多项用 ;; 分开，每一项是：步骤|按钮文字|确认提示|完整地址
# 步骤 5 显示在「下载 CC Switch」，步骤 6 显示在「下载 Codex / Claude Code」。
DOWNLOADS=5|Windows 下载|Windows 版 CC Switch|https://example.com/downloads/CC-Switch-Windows.msi;;5|苹果电脑下载|苹果电脑版 CC Switch|https://example.com/downloads/CC-Switch-macOS.dmg;;6|Windows 下载|Windows 版 Codex|https://example.com/downloads/Codex-Windows.exe;;6|Windows 下载|Windows 版 Claude Code|https://example.com/downloads/Claude-Code-Windows.exe

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=改成主站数据库密码
POSTGRES_DB=sub2api

SUB2API_BASE_URL=http://sub2api:8080
# 领奖入账使用的管理员。不要开启二次验证，也不要提交真实密码。
PORTAL_ADMIN_EMAIL=admin@example.com
PORTAL_ADMIN_PASSWORD=改成管理员密码
